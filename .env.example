# Copy to .env and adjust. Never commit the real .env.
RAJA_ENV=development              # set to "production" on the live server
SECRET_KEY=                       # REQUIRED in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://raja:raja@localhost:5432/raja_scout
POSTGRES_PASSWORD=                # REQUIRED for docker compose: python -c "import secrets;print(secrets.token_urlsafe(24))"
TRUSTED_PROXY_HOPS=0              # number of reverse proxies you control in front of the app (1 on most PaaS)
FORWARDED_ALLOW_IPS=127.0.0.1     # proxies trusted for X-Forwarded-Proto/For (uvicorn)
DEPLOYMENT_MODE=demo              # demo = fictional data + demo accounts; customer = real clubs (default in production)
PUBLIC_BASE_URL=                  # e.g. https://app.example.com — used in invitation / reset links
EXPOSE_API_DOCS=                  # default: shown in development, hidden in production
MAX_LOGIN_ATTEMPTS=5              # per account per LOGIN_LOCKOUT_SECONDS
MAX_LOGIN_ATTEMPTS_PER_IP=30      # per client IP per LOGIN_LOCKOUT_SECONDS
DEMO_PASSWORD=RajaDemo2026!       # password for demo accounts when seeding
TOKEN_EXPIRE_MINUTES=480
MIN_MINUTES_RELIABLE=900          # per-90 sample reliability threshold
MIN_MINUTES_POOL=450              # minimum minutes to enter percentile pools
CORS_ORIGINS=                     # comma-separated, only if the UI is served from another origin

# --- MCP (AI agents) — docs/mcp/MCP_ARCHITECTURE.md. Development only; never commit real tokens.
MCP_WRITE_TOOLS_ENABLED=false     # write tools stay unlisted until enabled (human approval still required)
MCP_RATE_LIMIT_PER_MINUTE=60      # per user, all MCP tools
# RAJA_SCOUT_MCP_TOKEN=           # set in your shell (from POST /api/auth/token), not in this file
# SPORTMONKS_API_TOKEN=           # only if you have your own key; dev exploration only (licence UNVERIFIED)
