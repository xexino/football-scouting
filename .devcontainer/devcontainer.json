{
  "name": "Raja Scout Intelligence",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/football-scouting",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Raja Scout Intelligence", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
